# Drop4Life Environment Variables Template
# Copy this file to .env.local for local development

# Application Configuration
NEXT_PUBLIC_APP_NAME=Drop4Life
NEXT_PUBLIC_APP_TAGLINE="Every Drop Can Save a Life."
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Persistence (Configured in Phase 14)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder

# Map Configuration
NEXT_PUBLIC_MAP_DEFAULT_LAT=28.6139
NEXT_PUBLIC_MAP_DEFAULT_LNG=77.2090
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12
